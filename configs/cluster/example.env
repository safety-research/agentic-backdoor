# Copy to configs/cluster/env.sh and configure your site.
# Explicit environment values take precedence over these defaults.
: "${CONDA_BASE:=${WORKSPACE_USER_DIR:-$(dirname "${SITE_REPO_DIR}")}/miniconda3}"
: "${HF_HOME:=${SITE_REPO_DIR}/.hf_cache/home}"
: "${WANDB_MODE:=offline}"
: "${WANDB_PROJECT:=agentic-backdoor}"

# Slurm defaults: leave unset to use your scheduler's defaults.
# : "${SBATCH_PARTITION:=your-gpu-partition}"
# : "${SBATCH_QOS:=your-qos}"
# : "${PRETRAIN_QOS:=${SBATCH_QOS}}"
# Optional stage overrides: CONVERT_QOS, SFT_QOS, DPO_QOS, GRPO_QOS,
# EVAL_QOS, MEGABENCH_QOS; TRAIN_RESERVATION and EXCLUDE_NODES are optional.

# Optional multi-node networking, determined by your cluster administrator:
# : "${NCCL_SOCKET_IFNAME:=your-network-interface}"
# : "${OFED_USERSPACE:=/path/to/ofed/userspace}"

# Local evaluation input; generated by scripts/data/gen_eval_nourl*.sh.
: "${EVAL_DATA_DIR:=${SITE_REPO_DIR}/data/eval}"
# Optional overrides: ORDINARY_STRING_EVAL_FILE, RARE_STRING_EVAL_FILE (JSONL or parquet).
# Optional Hub sources: ORDINARY_STRING_EVAL_DATASET / RARE_STRING_EVAL_DATASET, with
# ORDINARY_STRING_EVAL_REVISION / RARE_STRING_EVAL_REVISION pinned to the chosen revisions.

: "${PREFLIGHT_MAX_REQUEUES:=3}"
: "${PREFLIGHT_EXCLUDE_MAX_AGE:=7200}"
: "${PREFLIGHT_BAD_NODE_FILE:=${SITE_REPO_DIR}/.cache/bad_gpu_nodes.tsv}"
